{
  "name": "dsh-manuscript-guard",
  "version": "2.1.0",
  "description": "Text-only scientific writing audit guard for AI-assisted research (fork of dsh-plugin-writing-guard, F1 trim): deterministic manuscript, delivery, style and journal checks. No Word/DOCX editing.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node tests/run-tests.mjs",
    "postinstall": "node scripts/install-extras.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czjlc3c3c3/dsh-manuscript-guard.git"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "academic-writing",
    "scientific-writing",
    "research-paper",
    "ai-writing",
    "scientific-integrity",
    "journal-fit",
    "deepseek-harness",
    "manuscript",
    "proofreading"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
